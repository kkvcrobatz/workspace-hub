          "kind": "status",
          "taskName": "trading-stock-holdings-sync",
          "statusFiles": { "logFile": "E:\\Kyle\\Workspace\\trading\\data\\logs\\{date:yyyyMMdd}-sync-holdings.log" }
        }
      ]
