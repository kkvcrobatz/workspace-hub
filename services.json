{
  "_readme": "Workspace Hub 的服務清單（設定驅動：加服務＝加一段 JSON，不用重編譯；欄位說明見 README.md「卡片型態」）。appName：視窗標題／系統匣／捷徑名。群組或服務加 archived:true＝封存（預設隱藏、不探健康、無啟停）。字串樣板：{file:<路徑>} 讀檔去頭尾空白代入（token 檔）、{date:yyyyMMdd} 本機日期；可用在 open／healthUrl／statusFiles.*。kind:status 可填 taskName（Windows 工作排程器任務名，走 schtasks 讀上次／下次執行）並可搭配 statusFiles.logFile。kind:info＝純說明卡。stop.type kill 一定要設 processName（2026-07-30 誤殺教訓）。healthUrl 要用真實 API 路由——端口有回應≠服務健康。",
  "appName": "Workspace Hub",
  "groups": [
    {
      "name": "交易",
      "services": [
        {
          "id": "strategy-ledger",
          "name": "策略總帳",
          "desc": "所有策略的來源、假說、結果與淘汰原因（claude.ai artifact，用系統瀏覽器開）",
          "kind": "info",
          "open": "https://claude.ai/artifact/6NCUhc5zT5tVLudXh24Gjb",
          "external": true
        },
        {
          "id": "tw-stock-discipline",
          "name": "台股紀律檢查",
          "desc": "S1–S4 篩選＋持股 S5/S6 監控（非買進建議）．127.0.0.1:4327",
          "start": "powershell -NoProfile -ExecutionPolicy Bypass -File E:\\Kyle\\Workspace\\tw-stock-pullback\\scripts\\serve.ps1 -Persistent",
          "cwd": "E:\\Kyle\\Workspace\\tw-stock-pullback",
          "healthUrl": "http://127.0.0.1:4327/api/health",
          "open": "http://127.0.0.1:4327/?token={file:E:\\Kyle\\Workspace\\tw-stock-pullback\\.session-token-persistent}",
          "stop": { "type": "kill", "pattern": "twstock\\.app\\.serve", "processName": "python.exe" }
        },
        {
          "id": "broker-cockpit",
          "name": "交易駕駛艙（fake broker）",
          "desc": "broker-gateway 駕駛艙，--broker fake 不連群益．127.0.0.1:8787（首頁自動帶 token）",
          "start": "E:\\Kyle\\Workspace\\agent-harness\\runtime\\.venv\\Scripts\\python.exe -X utf8 scripts\\serve.py --broker fake",
          "cwd": "E:\\Kyle\\Workspace\\broker-gateway",
          "healthUrl": "http://127.0.0.1:8787/",
          "open": "http://127.0.0.1:8787/",
          "stop": { "type": "kill", "pattern": "scripts\\\\serve\\.py --broker", "processName": "python.exe" }
        },
        {
          "id": "record-capital",
          "name": "群益錄製器",
          "desc": "排程 trading-data-record-session（S4U），錄 TXF/MXF/TMF/SRF/NYF ticks",
          "kind": "status",
          "taskName": "trading-data-record-session",
          "statusFiles": { "logFile": "E:\\Kyle\\Workspace\\trading\\data\\logs\\{date:yyyyMMdd}-record.log" }
        },
        {
          "id": "record-fubon",
          "name": "富邦錄製器",
