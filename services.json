          "kind": "status",
          "taskName": "trading-data-record-session-fubon",
          "statusFiles": { "logFile": "E:\\Kyle\\Workspace\\trading\\data\\logs\\{date:yyyyMMdd}-record-fubon.log" }
        },
        {
          "id": "fetch-sinopac",
          "name": "永豐歷史 ticks 回補",
