          "kind": "status",
          "taskName": "trading-data-fetch-sinopac-ticks",
          "statusFiles": { "logFile": "E:\\Kyle\\Workspace\\trading\\data\\logs\\{date:yyyyMMdd}-fetch-sinopac.log" }
        },
        {
          "id": "fetch-daily",
          "name": "每晚資料排程",
          "desc": "排程 trading-data-fetch-daily（fetch-daily.ps1：期交所／台股篩選／Discord 摘要）",
          "kind": "status",
          "taskName": "trading-data-fetch-daily",
